# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/community-heatmap

# Auth
JWT_SECRET=change_me_to_a_strong_secret

# Escalation
ESCALATION_HOURS=72
ESCALATION_MIN_PRIORITY=30
ESCALATION_CRON=0 * * * *

# Seed defaults
SEED_ADMIN_EMAIL=admin@civic.local
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=System Admin

# Cloudinary (optional / currently unused)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
